# RecallBite LLM Configuration
# Copy this file to .env and fill in your values

# API key (leave empty to use deterministic local rules)
RECALLBITE_LLM_API_KEY=your-api-key-here

# Provider type: openai (default), deepseek, qwen, azure, ollama
# RECALLBITE_LLM_PROVIDER=openai

# Base URL (defaults depend on provider):
#   DeepSeek: https://api.deepseek.com
#   OpenAI:   https://api.openai.com/v1
#   Qwen:     https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama:   http://localhost:11434/v1
# RECALLBITE_LLM_BASE_URL=https://api.deepseek.com

# Model name (defaults depend on provider):
#   DeepSeek: deepseek-chat
#   OpenAI:   gpt-4o
#   Qwen:     qwen-max
#   Ollama:   llama3
# RECALLBITE_LLM_MODEL=deepseek-chat

# Optional: HTTP proxy for corporate networks
# RECALLBITE_HTTP_PROXY=http://127.0.0.1:7890

# Optional: skip SSL certificate verification (corporate networks only)
# RECALLBITE_LLM_SKIP_SSL_VERIFY=1
